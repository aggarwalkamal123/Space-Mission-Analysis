      <aliases enabled='yes' />
      <column caption='Successful Missions' datatype='integer' name='[Calculation_2208670300565507]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Mission_Success_Flag])' />
      </column>
      <column caption='Total Missions' datatype='integer' name='[Calculation_2208670300950532]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Mission_Detail])' />
      </column>
      <column caption='Failed Missions' datatype='integer' name='[Calculation_2208670302588933]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Mission_Detail]) - SUM([Mission_Success_Flag])' />
      </column>
      <column caption='Success Rate %' datatype='real' default-format='p0.0%' name='[Calculation_2208670302658566]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Mission_Success_Flag]) / COUNT([Mission_Detail])' />
      </column>
      <column caption='Quarter Name' datatype='string' name='[Calculation_2208670553260040]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Launch_Quarter]&#13;&#10;WHEN 1 THEN &quot;Q1&quot;&#13;&#10;WHEN 2 THEN &quot;Q2&quot;&#13;&#10;WHEN 3 THEN &quot;Q3&quot;&#13;&#10;WHEN 4 THEN &quot;Q4&quot;&#13;&#10;END' />
